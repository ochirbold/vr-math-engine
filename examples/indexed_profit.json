              -1,
              0
            ],
            "expression": "initial"
          },
          {
            "index": [
              -1,
              1
            ],
            "expression": "initial"
          }
        ]
      },
      "stock": {
        "axes": [
          "t",
          "w"
        ],
        "domain": "integer",
        "lower": 0,
        "upper": 8,
        "information": "scenario_specific",
        "boundary": [
          {
            "index": [
              -1,
              0
            ],
            "expression": "0"
          },
          {
            "index": [
              -1,
              1
            ],
            "expression": "0"
          }
        ]
      },
      "before_sales": {
        "axes": [
          "t",
          "w"
        ],
        "domain": "integer",
        "lower": 0,
        "upper": 8,
        "information": "scenario_specific"
      },
      "available": {
        "axes": [
          "t",
          "w"
        ],
        "domain": "binary",
        "lower": 0,
        "upper": 1,
        "information": "scenario_specific"
      },
      "sales": {
        "axes": [
          "t",
          "k",
          "w"
        ],
        "domain": "integer",
        "lower": 0,
        "upper": 8,
        "information": "scenario_specific"
      }
    },
    "objective": {
      "sense": "maximize",
      "terms": [
        {
          "over": [
            "t",
            "k",
            "w"
          ],
          "expression": "prob[w]*price[k]*sales[t,k,w]"
        },
        {
          "over": [
            "s",
            "t"
          ],
          "expression": "-cost[s]*order[s,t]-setup*opened[s,t]"
        },
        {
          "over": [
            "t",
            "w"
          ],
          "expression": "-prob[w]*holding*stock[t,w]"
        },
        {
          "over": [
            "t"
          ],
          "expression": "-allocation_cost*allocation[t]"
        },
        {
          "over": [],
          "expression": "-shelf_cost*selected"
        }
      ]
    },
    "constraints": [
      {
        "over": [
          "s",
          "t"
        ],
        "expression": "minimum*opened[s,t] <= order[s,t]"
      },
      {
        "over": [
          "s",
          "t"
        ],
        "expression": "order[s,t] <= capacity*opened[s,t]"
      },
      {
        "over": [
          "s"
        ],
        "expression": "order[s,1] == 0"
      },
      {
        "over": [],
        "expression": "allocation[0] == 0"
      },
      {
        "over": [],
        "expression": "SUM_OVER(k, chosen[k]) == 1"
      },
      {
        "over": [],
        "expression": "facings == selected"
      },
      {
        "over": [
          "t",
          "w"
        ],
        "expression": "warehouse[t,w] == warehouse[t-1,w]+SUM_OVER(s, reliability[s,w]*order[s,t-lead])-allocation[t]"
      },
      {
        "over": [
          "t",
          "w"
        ],
        "expression": "before_sales[t,w] == stock[t-1,w]+allocation[t]"
      },
      {
        "over": [
          "t",
          "w"
        ],
        "expression": "stock[t,w] == before_sales[t,w]-SUM_OVER(k, sales[t,k,w])"
      },
      {
        "over": [
          "t",
          "w"
        ],
        "expression": "available[t,w] <= before_sales[t,w]"
      },
      {
        "over": [
          "t",
          "w"
        ],
        "expression": "before_sales[t,w] <= stock_cap*available[t,w]"
      },
      {
        "over": [
          "t",
          "k",
          "w"
        ],
        "expression": "sales[t,k,w] <= demand[t,k,w]*chosen[k]"
      },
      {
        "over": [
          "t",
          "k",
          "w"
        ],
        "expression": "sales[t,k,w] <= stock_cap*selected"
      },
      {
        "over": [
          "t",
          "k",
          "w"
        ],
        "expression": "sales[t,k,w] <= stock_cap*available[t,w]"
      }
    ],
    "model_id": "indexed-profit",
    "version": "1",
    "kind": "indexed_program",
    "parameters": [
      "lead",
      "initial",
      "minimum",
      "capacity",
      "stock_cap",
      "setup",
      "holding",
      "allocation_cost",
      "shelf_cost"
    ],
    "inputs": [
