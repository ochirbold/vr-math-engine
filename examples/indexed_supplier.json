      }
    },
    "decisions": {
      "order": {
        "axes": [
          "s",
          "t"
        ],
        "domain": "integer",
        "lower": 0,
        "upper": 6,
        "boundary": [
          {
            "index": [
              0,
              -1
            ],
            "expression": "0"
          },
          {
            "index": [
              1,
              -1
            ],
            "expression": "0"
          }
        ]
      },
      "opened": {
        "axes": [
          "s",
          "t"
        ],
        "domain": "binary",
        "lower": 0,
        "upper": 1
      },
      "violation": {
        "axes": [
          "t",
          "w"
        ],
        "domain": "binary",
        "lower": 0,
        "upper": 1,
        "information": "scenario_specific"
      }
    },
    "objective": {
      "sense": "minimize",
      "terms": [
        {
          "over": [
            "s",
            "t"
          ],
          "expression": "cost[s]*order[s,t]+setup*opened[s,t]"
        },
        {
          "over": [
            "t",
            "w"
          ],
          "expression": "prob[w]*penalty*positive_part(demand[t,w]-SUM_OVER(s, reliability[s,w]*order[s,t-lead]))"
        }
      ]
    },
    "constraints": [
      {
        "over": [
          "s",
          "t"
        ],
        "expression": "minimum*opened[s,t] <= order[s,t]"
      },
      {
        "over": [
          "s",
          "t"
        ],
        "expression": "order[s,t] <= capacity*opened[s,t]"
      },
      {
        "over": [
          "t"
        ],
        "expression": "SUM_OVER(s, order[s,t]) == purchase[t]"
      },
      {
        "over": [
          "t",
          "w"
        ],
        "expression": "demand[t,w]-SUM_OVER(s, reliability[s,w]*order[s,t-lead]) <= big_m*violation[t,w]"
      },
      {
        "over": [
          "t"
        ],
        "expression": "SUM_OVER(w, prob[w]*violation[t,w]) <= epsilon"
      }
    ],
    "model_id": "indexed-supplier",
    "version": "1",
    "kind": "indexed_program",
    "parameters": [
      "lead",
      "setup",
      "penalty",
      "minimum",
      "capacity",
      "big_m",
      "epsilon"
    ],
    "inputs": [
      "s",
      "t",
      "w",
      "weight",
      "rate",
      "cost",
      "need",
      "purchase"
    ],
    "scenario_axis": "w",
    "probability_table": "prob"
  },
