{
  "model": {
    "model_id": "inscribed-ball", "version": "1", "kind": "linear_program",
    "inputs": ["price", "cost", "min_value", "max_value"],
    "parameters": ["threshold"],
    "formulas": [
      {"target": "margin", "expression": "price - cost", "stage": "row"},
      {"target": "margin_norm", "expression": "NORM(COLUMN('margin'))", "stage": "aggregate"},
      {"target": "center_value", "expression": "center", "stage": "post"},
      {"target": "radius_value", "expression": "radius", "stage": "post"}
    ],
    "decisions": {
      "center": {"size": "rows", "lower": null},
      "radius": {"lower": 0}
    },
    "objective": {"sense": "maximize", "expression": "radius"},
    "constraints": [
      "DOT(COLUMN('margin'), center) - radius * margin_norm >= threshold",
      "-center + radius <= -COLUMN('min_value')",
      "center + radius <= COLUMN('max_value')"
    ]
  },
  "parameters": {"threshold": 20},
  "dataset": {
    "row_ids": ["dimension-1", "dimension-2"],
    "rows": [
      {"price": 8, "cost": 5, "min_value": 0, "max_value": 10},
      {"price": 10, "cost": 6, "min_value": 0, "max_value": 10}
    ]
  }
}
