{
  "model": {
    "model_id": "assortment-literal-example",
    "version": "1",
    "kind": "indexed_program",
    "axes": {
      "i": [
        0,
        1,
        2
      ],
      "j": [
        0,
        1,
        2
      ],
      "k": [
        0,
        1,
        2,
        3
      ]
    },
    "inputs": [
      "i",
      "j",
      "k",
      "base_value",
      "eta_value",
      "margin_value",
      "setup_value",
      "width_value",
      "stock_value",
      "max_value",
      "rho_value"
    ],
    "parameters": [
      "shelf_capacity"
    ],
    "tables": {
      "baseline": {
        "axes": [
          "i"
        ],
        "column": "base_value"
      },
      "eta": {
        "axes": [
          "i"
        ],
        "column": "eta_value"
      },
      "margin": {
        "axes": [
          "i"
        ],
        "column": "margin_value"
      },
      "setup": {
        "axes": [
          "i"
        ],
        "column": "setup_value"
      },
      "width": {
        "axes": [
          "i"
        ],
        "column": "width_value"
      },
      "available": {
        "axes": [
          "i"
        ],
        "column": "stock_value"
      },
      "max_facings": {
        "axes": [
          "i"
        ],
        "column": "max_value"
      },
      "rho": {
        "axes": [
          "i",
          "j"
        ],
        "column": "rho_value"
      }
    },
    "decisions": {
      "selected": {
        "axes": [
          "i"
        ],
        "domain": "binary"
      },
      "facings": {
        "axes": [
          "i"
        ],
        "domain": "integer",
        "lower": 0,
        "upper": 3
      },
      "level": {
        "axes": [
          "i",
          "k"
        ],
        "domain": "binary"
      },
      "modeled_demand": {
        "axes": [
          "i"
        ],
        "lower": 0,
        "upper": 20
      },
      "sales": {
        "axes": [
          "i"
        ],
        "lower": 0,
        "upper": 20
      }
    },
    "objective": {
      "sense": "maximize",
      "terms": [
        {
          "over": [
            "i"
          ],
          "expression": "margin[i] * sales[i] - setup[i] * selected[i]"
        }
      ]
    },
    "constraints": [
      {
        "over": [
          "i"
        ],
        "expression": "SUM_OVER(k, level[i,k]) == 1"
      },
      {
        "over": [
          "i"
        ],
        "expression": "selected[i] == 1 - level[i,0]"
      },
      {
        "over": [
          "i"
        ],
        "expression": "facings[i] == SUM_OVER(k, k * level[i,k])"
      },
      {
        "over": [
          "i"
        ],
        "expression": "selected[i] <= facings[i]"
      },
      {
        "over": [
          "i"
        ],
        "expression": "facings[i] <= max_facings[i] * selected[i]"
      },
      {
        "expression": "SUM_OVER(i, width[i] * facings[i]) <= shelf_capacity"
      },
      {
        "over": [
          "i"
        ],
        "expression": "modeled_demand[i] == baseline[i] * selected[i] + eta[i] * SUM_OVER(k, log(1+k) * level[i,k]) + SUM_OVER(j, rho[i,j] * baseline[j] * (1-selected[j]))"
      },
      {
        "over": [
          "i"
        ],
        "expression": "sales[i] == modeled_demand[i] - positive_part(modeled_demand[i] - available[i])"
      },
      {
        "over": [
          "i",
          "j"
        ],
        "expression": "rho[i,j] >= 0"
      },
      {
        "over": [
          "i"
        ],
        "expression": "rho[i,i] == 0"
      },
      {
        "over": [
          "j"
        ],
        "expression": "SUM_OVER(i, rho[i,j]) <= 1"
      }
    ]
  },
  "parameters": {
    "shelf_capacity": 3.5
  },
