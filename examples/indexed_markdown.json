      },
      {
        "over": [
          "t",
          "k",
          "s"
        ],
        "expression": "sales[t,k,s] <= demand[t,k,s]*chosen[t,k]"
      },
      {
        "over": [
          "t",
          "s"
        ],
        "expression": "inventory[t,s] == inventory[t-1,s] - SUM_OVER(k, sales[t,k,s])"
      }
    ]
